{
  "name": "nextgen-marketingai-backend",
  "version": "1.0.0",
  "description": "NextGen MarketingAI - NestJS Backend",
  "author": "NextGen Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:plans": "ts-node prisma/seed-plans.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "start": "node --use-system-ca --no-deprecation dist/main",
    "start:debug": "cross-env NODE_OPTIONS=--use-system-ca nest start --debug --watch",
    "start:dev": "cross-env NODE_OPTIONS=--use-system-ca nest start --watch",
    "start:prod": "node --use-system-ca --no-deprecation dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:site:e2e": "ts-node scripts/website-e2e.ts",
    "test:isolation": "ts-node scripts/isolation-check.ts",
    "test:reel:e2e": "ts-node scripts/reel-e2e.ts",
    "test:reel": "ts-node scripts/reel-frame-check.ts",
    "build:css": "ts-node scripts/build-website-css.ts",
    "test:mail": "ts-node scripts/mail-check.ts",
    "test:auth": "ts-node scripts/auth-check.ts",
    "test:blueprint": "ts-node scripts/blueprint-check.ts",
    "test:menu": "ts-node scripts/menu-document-check.ts",
    "test:billing": "ts-node scripts/billing-webhook-check.ts",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:watch": "jest --watch",
    "test:reel:voice": "ts-node scripts/reel-voice-check.ts",
    "test:studio": "ts-node scripts/studio-e2e.ts",
    "test:admin": "ts-node scripts/admin-login-check.ts",
    "test:menu:qr": "ts-node scripts/menu-qr-check.ts",
    "test:art": "ts-node scripts/art-direction-filter-check.ts",
    "test:images": "ts-node scripts/image-health-check.ts",
    "demo:cafe": "ts-node scripts/demo-cafe.ts",
    "test:autopost": "ts-node scripts/auto-post-check.ts"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.0.0",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "fluent-ffmpeg": "^2.1.3",
    "nodemailer": "^10.0.10",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "sharp": "^0.35.3",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^3.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^5.0.0",
    "source-map-support": "^0.5.0",
    "supertest": "^6.0.0",
    "ts-jest": "^29.0.0",
    "ts-loader": "^9.0.0",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
